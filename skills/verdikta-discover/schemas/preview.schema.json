{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "decision": {
      "enum": [
        "PREVIEW",
        "LOCAL",
        "NEEDS_SCOPE",
        "UNSUITABLE",
        "HANDOFF_REQUESTED"
      ]
    },
    "quote_status": {
      "const": "DRAFT_NOT_QUOTED"
    },
    "template_id": {
      "enum": [
        "source-check-v1",
        "evidence-pack-v1",
        null
      ]
    },
    "network": {
      "enum": [
        "UNSELECTED",
        "BASE",
        "BASE_SEPOLIA"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "supplier": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "NONE"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "status",
        "candidates"
      ],
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "properties": {
        "reward_wei": {
          "type": "null"
        },
        "buyer_gas_estimate_wei": {
          "type": "null"
        },
        "evaluation_prepay_estimate_wei": {
          "type": "null"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reward_wei",
        "buyer_gas_estimate_wei",
        "evaluation_prepay_estimate_wei",
        "explanation"
      ],
      "additionalProperties": false
    },
    "can_commission": {
      "const": false
    },
    "authorization_granted": {
      "const": false
    },
    "funds_moved": {
      "const": false
    },
    "inputs_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "task_summary": {
      "type": "string"
    },
    "price_status": {
      "const": "UNKNOWN"
    },
    "availability_status": {
      "const": "UNKNOWN"
    },
    "procurement": {
      "type": "object",
      "required": [
        "mode",
        "targetHunter"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "UNSELECTED",
            "OPEN",
            "TARGETED"
          ]
        },
        "targetHunter": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "OPEN",
                  "UNSELECTED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "targetHunter": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "deliverable": {
      "type": "array"
    },
    "acceptance_criteria": {
      "type": "array"
    },
    "commissioning_requirements": {
      "type": "array"
    },
    "why_outsource": {
      "type": "array"
    },
    "why_not_outsource": {
      "type": "array"
    },
    "draft": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "template_id",
            "request",
            "rubric",
            "threshold",
            "procurement",
            "sharing_authorized"
          ],
          "additionalProperties": false,
          "properties": {
            "template_id": {
              "enum": [
                "source-check-v1",
                "evidence-pack-v1"
              ]
            },
            "request": {
              "type": "object"
            },
            "rubric": {
              "type": "object"
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "procurement": {
              "allOf": [
                {
                  "type": "object",
                  "required": [
                    "mode",
                    "targetHunter"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "enum": [
                        "UNSELECTED",
                        "OPEN",
                        "TARGETED"
                      ]
                    },
                    "targetHunter": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "mode": {
                            "enum": [
                              "OPEN",
                              "UNSELECTED"
                            ]
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "targetHunter": {
                            "type": "null"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "properties": {
                    "mode": {
                      "enum": [
                        "OPEN",
                        "TARGETED"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "TARGETED"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "targetHunter": {
                        "type": "string",
                        "not": {
                          "const": "0x0000000000000000000000000000000000000000"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "sharing_authorized": {
              "const": true
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "decision",
    "quote_status",
    "template_id",
    "network",
    "reason",
    "supplier",
    "costs",
    "can_commission",
    "authorization_granted",
    "funds_moved",
    "inputs_needed",
    "risks",
    "next_action",
    "draft",
    "procurement"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "LOCAL",
              "UNSUITABLE",
              "NEEDS_SCOPE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "draft": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "PREVIEW",
              "HANDOFF_REQUESTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "draft": {
            "type": "object"
          },
          "procurement": {
            "properties": {
              "mode": {
                "enum": [
                  "OPEN",
                  "TARGETED"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "TARGETED"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "targetHunter": {
                      "type": "string",
                      "not": {
                        "const": "0x0000000000000000000000000000000000000000"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "draft": {
            "type": "object",
            "properties": {
              "procurement": {
                "properties": {
                  "mode": {
                    "const": "OPEN"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "procurement": {
            "properties": {
              "mode": {
                "const": "OPEN"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "draft": {
            "type": "object",
            "properties": {
              "procurement": {
                "properties": {
                  "mode": {
                    "const": "TARGETED"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "procurement": {
            "properties": {
              "mode": {
                "const": "TARGETED"
              }
            }
          }
        }
      }
    }
  ]
}
