{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_only": {
      "type": "boolean"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "provenance": {
            "enum": [
              "INDEPENDENT_PUBLIC_RETRIEVAL",
              "BUYER_PROVIDED",
              "SYNTHETIC_FIXTURE"
            ]
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "url",
          "title",
          "version",
          "retrieved_at",
          "provenance",
          "snapshot_sha256",
          "locator",
          "excerpt"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "provenance": {
                  "const": "INDEPENDENT_PUBLIC_RETRIEVAL"
                }
              }
            },
            "then": {
              "properties": {
                "retrieved_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "FOUND",
              "CONFLICTING",
              "UNRESOLVED"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "value",
                "evidence_ids"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": [
                    "INSPECTED_PROVIDED",
                    "RETRIEVED",
                    "NOT_FOUND",
                    "ACCESS_BLOCKED",
                    "OUT_OF_SCOPE"
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "location",
                "outcome",
                "note"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "entity_id",
          "field_id",
          "status",
          "value",
          "evidence_ids",
          "alternatives",
          "explanation",
          "effort"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "FOUND"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "evidence_ids": {
                  "minItems": 1
                },
                "alternatives": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                },
                "alternatives": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "CONFLICTING"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                },
                "alternatives": {
                  "minItems": 2
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 50
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "fixture_only",
    "input_sha256",
    "sources",
    "limitations",
    "cells"
  ],
  "additionalProperties": false
}
