{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_only": {
      "type": "boolean"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "provenance": {
            "enum": [
              "INDEPENDENT_PUBLIC_RETRIEVAL",
              "BUYER_PROVIDED",
              "SYNTHETIC_FIXTURE"
            ]
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "url",
          "title",
          "version",
          "retrieved_at",
          "provenance",
          "snapshot_sha256",
          "locator",
          "excerpt"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "provenance": {
                  "const": "INDEPENDENT_PUBLIC_RETRIEVAL"
                }
              }
            },
            "then": {
              "properties": {
                "retrieved_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "CONTRADICTED",
              "UNRESOLVED"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": [
                    "INSPECTED_PROVIDED",
                    "RETRIEVED",
                    "NOT_FOUND",
                    "ACCESS_BLOCKED",
                    "OUT_OF_SCOPE"
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "location",
                "outcome",
                "note"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10
          },
          "original_claim": {
            "type": "string",
            "minLength": 1
          },
          "version_scope": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "minLength": 1
          },
          "unresolved_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "claim_id",
          "status",
          "evidence_ids",
          "explanation",
          "effort",
          "original_claim",
          "version_scope",
          "as_of",
          "unresolved_reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "SUPPORTED",
                    "CONTRADICTED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "UNRESOLVED"
                }
              }
            },
            "then": {
              "properties": {
                "unresolved_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "fixture_only",
    "input_sha256",
    "sources",
    "limitations",
    "claims"
  ],
  "additionalProperties": false
}
